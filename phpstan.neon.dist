parameters:
    level: 4
    paths:
        - src
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    # `headerActions()` / `modalActions()` are user-overridable extension points,
    # so their PHPDoc element types are a promise, not a runtime guarantee —
    # the `instanceof` guards that validate them must stay reachable.
    treatPhpDocTypesAsCertain: false
